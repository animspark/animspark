{
  "name": "@animspark/p5",
  "version": "0.1.0",
  "description": "P5 generative art package: p5.js with a system-managed canvas, per-frame reseeding for determinism, and synchronous frame output.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./playback": {
      "types": "./src/playback.ts",
      "import": "./src/playback.ts",
      "default": "./src/playback.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"src/**/*.test.ts\""
  },
  "animspark": {
    "scenePackage": true,
    "developer": {
      "id": "animspark",
      "name": "AnimSpark"
    },
    "packageName": "animspark/p5",
    "tagline": "2D generative art (p5.js): write an instance-mode draw(p, P) illustration layer in <P5 />; the system handles the canvas, per-frame reseeding for determinism, and synchronous frame output.",
    "keywords": [
      "p5",
      "generative",
      "art",
      "noise",
      "particles",
      "organic",
      "texture",
      "illustration",
      "flow-field"
    ],
    "components": [
      "p5"
    ],
    "extensions": {
      "p5": {
        "title": "P5 Generative Art",
        "tagline": "Procedural illustration layers: noise flow fields, particle painting and organic textures. Deterministic per frame, seekable anywhere.",
        "components": [
          "p5"
        ]
      }
    },
    "playbackByCapability": {
      "p5": "./playback"
    },
    "vocabulary": [
      "p5"
    ],
    "engine": ">=0.0.1"
  },
  "dependencies": {
    "p5": "^1.11.13"
  },
  "peerDependencies": {
    "@animspark/scene-engine": "workspace:*"
  },
  "devDependencies": {
    "@animspark/scene-engine": "workspace:*",
    "@types/node": "^22.0.0",
    "@types/p5": "^1.7.7",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "files": [
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/animspark/animspark.git",
    "directory": "scene-packages/p5"
  },
  "homepage": "https://github.com/animspark/animspark/tree/main/scene-packages/p5",
  "bugs": {
    "url": "https://github.com/animspark/animspark/issues"
  }
}
