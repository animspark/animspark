{
  "name": "@muspark/ui",
  "version": "0.1.0",
  "description": "Score visualization: staff notation, piano roll, tablature, harmony, rhythm, arrangement, intervals, timbre, instruments, mixer and timeline. Shares the same score data as @muspark/core.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./react": {
      "types": "./src/author.ts",
      "import": "./src/author.ts",
      "default": "./src/author.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@muspark/core": "workspace:*"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/react": "^19.0.0",
    "react": "^19.0.0",
    "typescript": "^5.7.2",
    "tsx": "^4.19.0"
  },
  "files": [
    "src",
    "SKILL.md",
    "APIs",
    "references",
    "catalog.json",
    "cover.jpg",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/animspark/animspark.git",
    "directory": "packages/muspark-ui"
  },
  "homepage": "https://github.com/animspark/animspark/tree/main/packages/muspark-ui",
  "bugs": {
    "url": "https://github.com/animspark/animspark/issues"
  }
}
