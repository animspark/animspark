{"src":"assets/audio/vo/01-stage.m4a","kind":"audio","bytes":157727,"dur":13.44,"text":"Stage. Scene. Cue. Track. AnimSpark borrowed its words from the theatre, where a stage is a fixed frame, and everything has to happen inside it.","hasAudio":true,"hasVideo":false,"from":{"mode":"synth"},"voiceId":"fzULqveKptV3RCpeI3mp","words":[{"token":"Stage.","start":0,"end":0.72},{"token":"Scene.","start":0.867,"end":1.68},{"token":"Cue.","start":1.98,"end":2.96},{"token":"Track.","start":3.213,"end":4.56},{"token":"AnimSpark","start":4.896,"end":6.64},{"token":"borrowed","start":6.684,"end":7.04},{"token":"its","start":7.08,"end":7.2},{"token":"words","start":7.267,"end":7.6},{"token":"from","start":7.648,"end":7.84},{"token":"the","start":7.86,"end":7.92},{"token":"theatre","start":7.98,"end":8.4},{"token":"where","start":8.68,"end":9.28},{"token":"a","start":9.32,"end":9.36},{"token":"stage","start":9.44,"end":9.84},{"token":"is","start":9.893,"end":10},{"token":"a","start":10.04,"end":10.08},{"token":"fixed","start":10.147,"end":10.48},{"token":"frame","start":10.547,"end":10.88},{"token":"and","start":11.32,"end":11.44},{"token":"everything","start":11.484,"end":11.92},{"token":"has","start":12,"end":12.24},{"token":"to","start":12.267,"end":12.32},{"token":"happen","start":12.366,"end":12.64},{"token":"inside","start":12.709,"end":13.12},{"token":"it.","start":13.2,"end":13.44}]}
{"src":"assets/audio/vo/02-script.m4a","kind":"audio","bytes":96358,"dur":7.68,"text":"It starts in the prompt book. One sentence becomes a list of beats, and every beat has to change something you can see.","hasAudio":true,"hasVideo":false,"from":{"mode":"synth"},"voiceId":"fzULqveKptV3RCpeI3mp","words":[{"token":"It","start":0,"end":0.08},{"token":"starts","start":0.149,"end":0.56},{"token":"in","start":0.587,"end":0.64},{"token":"the","start":0.66,"end":0.72},{"token":"prompt","start":0.777,"end":1.12},{"token":"book.","start":1.184,"end":1.52},{"token":"One","start":1.74,"end":2.4},{"token":"sentence","start":2.462,"end":2.96},{"token":"becomes","start":3.01,"end":3.36},{"token":"a","start":3.4,"end":3.44},{"token":"list","start":3.488,"end":3.68},{"token":"of","start":3.733,"end":3.84},{"token":"beats","start":3.907,"end":4.24},{"token":"and","start":4.68,"end":4.8},{"token":"every","start":4.84,"end":5.04},{"token":"beat","start":5.12,"end":5.44},{"token":"has","start":5.5,"end":5.68},{"token":"to","start":5.733,"end":5.84},{"token":"change","start":5.897,"end":6.24},{"token":"something","start":6.288,"end":6.72},{"token":"you","start":6.78,"end":6.96},{"token":"can","start":7,"end":7.12},{"token":"see.","start":7.22,"end":7.68}]}
{"src":"assets/audio/vo/03-set.m4a","kind":"audio","bytes":138153,"dur":11.36,"text":"The set is built once: palette, typeface, surface. And a few pieces return in every scene. Rearranged, never redrawn.","hasAudio":true,"hasVideo":false,"from":{"mode":"synth"},"voiceId":"fzULqveKptV3RCpeI3mp","words":[{"token":"The","start":0,"end":0.08},{"token":"set","start":0.18,"end":0.48},{"token":"is","start":0.56,"end":0.72},{"token":"built","start":0.787,"end":1.12},{"token":"once","start":1.2,"end":1.52},{"token":"palette","start":2.22,"end":2.64},{"token":"typeface","start":3.024,"end":3.6},{"token":"surface.","start":3.83,"end":4.48},{"token":"And","start":4.72,"end":5.44},{"token":"a","start":5.48,"end":5.52},{"token":"few","start":5.58,"end":5.76},{"token":"pieces","start":5.817,"end":6.16},{"token":"return","start":6.251,"end":6.8},{"token":"in","start":6.88,"end":7.04},{"token":"every","start":7.107,"end":7.44},{"token":"scene.","start":7.507,"end":7.92},{"token":"Rearranged","start":8.144,"end":9.52},{"token":"never","start":10.08,"end":10.48},{"token":"redrawn.","start":10.571,"end":11.36}]}
{"src":"assets/audio/vo/04-blocking.m4a","kind":"audio","bytes":121839,"dur":10.16,"text":"Blocking is how things move. Never straight from A to B, but a breath before the step, and a settle after. The curve is the character.","hasAudio":true,"hasVideo":false,"from":{"mode":"synth"},"voiceId":"fzULqveKptV3RCpeI3mp","words":[{"token":"Blocking","start":0,"end":0.4},{"token":"is","start":0.453,"end":0.56},{"token":"how","start":0.6,"end":0.72},{"token":"things","start":0.766,"end":1.04},{"token":"move.","start":1.136,"end":1.6},{"token":"Never","start":1.72,"end":2.32},{"token":"straight","start":2.373,"end":2.8},{"token":"from","start":2.848,"end":3.04},{"token":"A","start":3.16,"end":3.28},{"token":"to","start":3.333,"end":3.44},{"token":"B","start":3.6,"end":3.76},{"token":"but","start":4.26,"end":4.32},{"token":"a","start":4.4,"end":4.48},{"token":"breath","start":4.537,"end":4.88},{"token":"before","start":4.926,"end":5.2},{"token":"the","start":5.24,"end":5.36},{"token":"step","start":5.44,"end":5.76},{"token":"and","start":6.2,"end":6.32},{"token":"a","start":6.36,"end":6.4},{"token":"settle","start":6.469,"end":6.88},{"token":"after.","start":6.96,"end":7.52},{"token":"The","start":7.74,"end":8.4},{"token":"curve","start":8.507,"end":9.04},{"token":"is","start":9.147,"end":9.36},{"token":"the","start":9.38,"end":9.44},{"token":"character.","start":9.504,"end":10.16}]}
{"src":"assets/audio/vo/05-cue.m4a","kind":"audio","bytes":156881,"dur":13.04,"text":"Then, the cue. A stage manager listens, and calls it. Lights twelve: go. Here, the spoken word is the cue, and light, sound and motion land on the same syllable.","hasAudio":true,"hasVideo":false,"from":{"mode":"synth"},"voiceId":"fzULqveKptV3RCpeI3mp","words":[{"token":"Then","start":0,"end":0.24},{"token":"the","start":0.38,"end":0.56},{"token":"cue.","start":0.66,"end":1.04},{"token":"A","start":1.36,"end":1.68},{"token":"stage","start":1.733,"end":2},{"token":"manager","start":2.06,"end":2.48},{"token":"listens","start":2.53,"end":2.88},{"token":"and","start":3,"end":3.12},{"token":"calls","start":3.187,"end":3.52},{"token":"it.","start":3.6,"end":3.84},{"token":"Lights","start":4.011,"end":5.04},{"token":"twelve","start":5.109,"end":5.52},{"token":"go.","start":6.187,"end":6.56},{"token":"Here","start":6.752,"end":7.52},{"token":"the","start":7.64,"end":7.76},{"token":"spoken","start":7.817,"end":8.16},{"token":"word","start":8.208,"end":8.4},{"token":"is","start":8.453,"end":8.56},{"token":"the","start":8.58,"end":8.64},{"token":"cue","start":8.74,"end":9.04},{"token":"and","start":9.22,"end":9.52},{"token":"light","start":9.573,"end":9.84},{"token":"sound","start":10.133,"end":10.4},{"token":"and","start":10.46,"end":10.64},{"token":"motion","start":10.709,"end":11.12},{"token":"land","start":11.248,"end":11.76},{"token":"on","start":11.84,"end":12},{"token":"the","start":12.02,"end":12.08},{"token":"same","start":12.144,"end":12.4},{"token":"syllable.","start":12.464,"end":13.04}]}
{"src":"assets/audio/vo/06-change.m4a","kind":"audio","bytes":72406,"dur":5.92,"text":"A scene change holds one thing still while the world moves around it, so your eye never has to search.","hasAudio":true,"hasVideo":false,"from":{"mode":"synth"},"voiceId":"fzULqveKptV3RCpeI3mp","words":[{"token":"A","start":0,"end":0.08},{"token":"scene","start":0.12,"end":0.32},{"token":"change","start":0.389,"end":0.8},{"token":"holds","start":0.853,"end":1.12},{"token":"one","start":1.16,"end":1.28},{"token":"thing","start":1.333,"end":1.6},{"token":"still","start":1.693,"end":2.16},{"token":"while","start":2.213,"end":2.48},{"token":"the","start":2.5,"end":2.56},{"token":"world","start":2.613,"end":2.88},{"token":"moves","start":2.92,"end":3.12},{"token":"around","start":3.166,"end":3.44},{"token":"it","start":3.52,"end":3.68},{"token":"so","start":4.053,"end":4.16},{"token":"your","start":4.192,"end":4.32},{"token":"eye","start":4.38,"end":4.56},{"token":"never","start":4.627,"end":4.96},{"token":"has","start":5.02,"end":5.2},{"token":"to","start":5.253,"end":5.36},{"token":"search.","start":5.429,"end":5.92}]}
{"src":"assets/audio/vo/07-track.m4a","kind":"audio","bytes":126625,"dur":10.56,"text":"Each scene carries its own sound. Slide it along the track, and the sound slides with it. Even the music is written as notes the picture can read.","hasAudio":true,"hasVideo":false,"from":{"mode":"synth"},"voiceId":"fzULqveKptV3RCpeI3mp","words":[{"token":"Each","start":0,"end":0.24},{"token":"scene","start":0.32,"end":0.72},{"token":"carries","start":0.76,"end":1.04},{"token":"its","start":1.1,"end":1.28},{"token":"own","start":1.34,"end":1.52},{"token":"sound.","start":1.613,"end":2.24},{"token":"Slide","start":2.427,"end":3.36},{"token":"it","start":3.413,"end":3.52},{"token":"along","start":3.56,"end":3.76},{"token":"the","start":3.78,"end":3.84},{"token":"track","start":3.92,"end":4.32},{"token":"and","start":4.48,"end":4.72},{"token":"the","start":4.74,"end":4.8},{"token":"sound","start":4.867,"end":5.2},{"token":"slides","start":5.269,"end":5.68},{"token":"with","start":5.728,"end":5.92},{"token":"it.","start":6,"end":6.24},{"token":"Even","start":6.448,"end":7.28},{"token":"the","start":7.3,"end":7.36},{"token":"music","start":7.44,"end":7.84},{"token":"is","start":7.893,"end":8},{"token":"written","start":8.05,"end":8.4},{"token":"as","start":8.48,"end":8.64},{"token":"notes","start":8.72,"end":9.12},{"token":"the","start":9.16,"end":9.28},{"token":"picture","start":9.33,"end":9.68},{"token":"can","start":9.74,"end":9.92},{"token":"read.","start":10,"end":10.56}]}
{"src":"assets/audio/vo/08-curtain.m4a","kind":"audio","bytes":130048,"dur":10.96,"text":"House lights. Everything you saw takes a bow: the set, the light, the sound, the words. This film was called from its own cue sheet.","from":{"mode":"synth"},"voiceId":"fzULqveKptV3RCpeI3mp","words":[{"token":"House","start":0,"end":0.24},{"token":"lights.","start":0.297,"end":0.72},{"token":"Everything","start":0.829,"end":1.92},{"token":"you","start":1.98,"end":2.16},{"token":"saw","start":2.24,"end":2.48},{"token":"takes","start":2.533,"end":2.8},{"token":"a","start":2.84,"end":2.88},{"token":"bow","start":2.98,"end":3.28},{"token":"the","start":3.88,"end":4},{"token":"set","start":4.12,"end":4.48},{"token":"the","start":4.82,"end":4.88},{"token":"light","start":4.96,"end":5.36},{"token":"the","start":5.7,"end":5.76},{"token":"sound","start":5.853,"end":6.32},{"token":"the","start":6.66,"end":6.72},{"token":"words.","start":6.8,"end":7.28},{"token":"This","start":7.504,"end":8.4},{"token":"film","start":8.464,"end":8.72},{"token":"was","start":8.76,"end":8.88},{"token":"called","start":8.949,"end":9.36},{"token":"from","start":9.424,"end":9.68},{"token":"its","start":9.72,"end":9.84},{"token":"own","start":9.9,"end":10.08},{"token":"cue","start":10.18,"end":10.48},{"token":"sheet.","start":10.533,"end":10.96}]}
