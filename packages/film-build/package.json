{
  "name": "@animspark/film-build",
  "version": "0.1.0",
  "description": "Server-side tools for a film.tsx workspace: evaluate the tree, measure media, mix down audio, and check the whole film. The CLI and the web app share the same code.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./doc-edit": "./src/code/doc-edit.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@animspark/core": "workspace:*",
    "@muspark/core": "workspace:*",
    "esbuild": "^0.25.0",
    "@animspark/runtime": "workspace:*",
    "typescript": "^5.7.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "files": [
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/animspark/animspark.git",
    "directory": "packages/film-build"
  },
  "homepage": "https://github.com/animspark/animspark/tree/main/packages/film-build",
  "bugs": {
    "url": "https://github.com/animspark/animspark/issues"
  }
}
